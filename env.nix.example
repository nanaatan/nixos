{
  monitorPrimary = "eDP";
  monitorExternal = "HDMI-A-0";
  resNative = "2880x1620";
  resFHD = "1920x1080";
  
  hzMax = "120";
  hzMin = "60";
  
  battery = "BAT0";
  gpuDriver = "amdgpu";
  # true: use the NVIDIA dGPU (gpu.nix, PRIME offload). false: sever it (profiles/no-nvidia.nix)
  useNvidia = false;

  # "podman" or "docker", takes effect after a rebuild
  containerRuntime = "podman";

}
